^SAMPLE = GSM5013301
!Sample_title = CRLM01
!Sample_geo_accession = GSM5013301
!Sample_status = Public on Feb 12 2022
!Sample_submission_date = Jan 10 2021
!Sample_last_update_date = Feb 12 2022
!Sample_type = SRA
!Sample_channel_count = 1
!Sample_source_name_ch1 = Single CD45+ cells (anti-human CD45, HI30, eBiocience)
!Sample_organism_ch1 = Homo sapiens
!Sample_taxid_ch1 = 9606
!Sample_characteristics_ch1 = subject status: colorectal cancer patients with liver metastasis
!Sample_characteristics_ch1 = tissue: tumor, adjacent-normal,blood,lymph node
!Sample_characteristics_ch1 = platform: 10X 3'
!Sample_molecule_ch1 = polyA RNA
!Sample_extract_protocol_ch1 = Single CD45+ cells (anti-human CD45, HI30, eBiocience) of the samples of each patient were sorted into 1.5 mL low binding tubes (Eppendorf) with 50 μL sorting buffer for droplet-based scRNA-seq, or into wells of 96-well plates (Axygen) for plated-based scRNA-seq, prepared with lysis buffer which contained 1 mL 10 mM dNTP mix (Fermentas), 1 mL 10 mM Oligo dT primer, 1.9 mL 1% Triton X-100 (Sigma) plus 0.1 mL 40 U/ml RNase Inhibitor (Takara). The sealed plates were stored frozen at 80 C.
!Sample_extract_protocol_ch1 = Fresh tumor, adjacent liver tissue and lymph node samples were cut into approximately 1 mm3 pieces in the RPMI-1640 medium (Invitrogen) with 10% fetal bovine serum (FBS; Sciencell), and enzymatically digested with MACS tumor dissociation kit (Miltenyi Biotec) for 30 min on a rotor at 37 C, according to the manufacturer’s instructions. After filtered by 70 mm Cell-Strainer (BD) in the RPMI-1640 medium (Invitrogen), the suspended cells were centrifuged at 400 g for 5 min. After removing the supernatant, the pelleted cells were suspended in red blood cell lysis buffer (Solarbio) and incubated on ice for 2 min to lyse red blood cells. The cell pellets were resuspended in sorting buffer (PBS supplemented with 2% FBS) after washing twice with PBS (Invitrogen). Peripheral blood mononuclear cells (PBMCs) and ascites were isolated using the HISTOPAQUE-1077 (Sigma-Aldrich) solution as previously described51. Briefly, 5 mL fresh peripheral blood or ascites was collected prior to surgery in EDTA anticoagulant tubes and subsequently layered onto HISTOPAQUE-1077. After centrifugation, immune cells remained at the plasma-HISTOPAQUE-1077 interface and were transferred to a new tube, with twice washing using PBS. These immune cells were resuspended with sorting buffers.
!Sample_extract_protocol_ch1 = 10x Chromium Single cell 3’, 10x Chromium Single cell 5’ + VDJ Library, and Smart-seq2 Library
!Sample_data_processing = For 10X data, Cell Ranger 3.0.0 was used to quantify gene expression level and to identify TCR sequences.
!Sample_data_processing = For Smart-seq2 data, HTSeqGenie pipeline (R package version 4.8) was used to quantify gene expression level.
!Sample_data_processing = Genome_build: GRCh38 for RNA expression and TCR data.
!Sample_data_processing = Supplementary_files_format_and_content: expression matrix (UMI counts), cell metadata, TCR summary.
!Sample_platform_id = GPL20795
!Sample_contact_name = Yedan,,Liu
!Sample_contact_email = 1701110453@pku.edu.cn
!Sample_contact_institute = Peking University
!Sample_contact_address = Yiheyuan
!Sample_contact_city = Beijing
