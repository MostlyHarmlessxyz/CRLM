^SERIES = GSE203608
!Series_title = Mapping and modeling human colorectal carcinoma interactions with the tumor microenvironment
!Series_geo_accession = GSE203608
!Series_status = Public on Oct 20 2023
!Series_submission_date = May 23 2022
!Series_last_update_date = Dec 13 2023
!Series_pubmed_id = 38036590
!Series_summary = Tumoroid cultures suppress gene expression programs involved in communication with the TME, and introduction of human monocyte-derived macrophages into tumoroid cultures instructs macrophages to acquire pro-tumorigenic gene expression programs similar to those observed in vivo.
!Series_overall_design = We collected primary tumors, phenotypically normal adjacent colonic tissue, and liver metastases. Single cell profiling were done using 10x chromium single cell RNA sequencing library kit and Nova-Seq kit. The single cells derived from cultured organoid and organoid/Macrophage co-culture  were profiled same way and compared to its in vivo counterpart.
!Series_type = Expression profiling by high throughput sequencing
!Series_contributor = Li,,Ning
!Series_contributor = Zhu,,Qin
!Series_contributor = Tan,,Kai
!Series_contributor = Lengner,,Chris
